    "axios": "1.19.0",
    "duplex": "1.0.0",
    "elasticio-rest-node": "2.0.0",
    "elasticio-sailor-nodejs": "2.7.8",
    "better-npm-audit": "3.11.0",
    "form-data": "4.0.6",
    "request-promise": "4.2.6",
    "uuid": "14.0.1",
